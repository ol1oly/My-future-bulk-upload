{
  "manifest_version": 3,
  "key": "",
  "name": "myFuture Toolkit",
  "version": "0.3.0",
  "description": "Smart search, shortlist and apply helpers for McGill myFuture job postings, plus a local bridge for scripted document uploads.",
  "permissions": [
    "activeTab",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://myfuture.mcgill.ca/*"
  ],
  "background": {
    "service_worker": "bridge.js"
  },
  "action": {
    "default_title": "myFuture Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/martlet-16.png",
      "32": "assets/martlet-32.png",
      "48": "assets/martlet-48.png",
      "128": "assets/martlet-128.png"
    }
  },
  "icons": {
    "16": "assets/martlet-16.png",
    "32": "assets/martlet-32.png",
    "48": "assets/martlet-48.png",
    "128": "assets/martlet-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://myfuture.mcgill.ca/*"
      ],
      "js": [
        "apply-helper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
